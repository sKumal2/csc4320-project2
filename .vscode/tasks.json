{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build active file (C++20)",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++20", "-Wall", "-Wextra", "-pthread", "${file}", "-o", "${workspaceFolder}/bin/${fileBasenameNoExtension}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
